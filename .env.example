# Copy this file to .env and adjust values for your local machine.
# Never commit .env or any file containing real secrets; only .env.example
# is tracked by git.

# Docker Compose project namespace. Keep this value stable across the team
# so container, network and volume names do not collide between checkouts.
COMPOSE_PROJECT_NAME=rv-dev-environment

# Host port exposed for the smoke component HTTP health endpoint.
SMOKE_HTTP_PORT=8080

# Free-text, non-sensitive label. It is intentionally required with no
# default in compose.yaml so doctor.sh/up.sh can demonstrate detection of
# missing mandatory configuration.
SMOKE_ENVIRONMENT_LABEL=local
